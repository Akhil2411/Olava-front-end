# Copy to .env.local and adjust. Server-only values (no NEXT_PUBLIC_ prefix): never sent to the browser.

# The Olava .NET API (use the "http" launch profile locally: dotnet run --launch-profile http)
OLAVA_API_URL=http://localhost:5033

# Optional: serve public sites on subdomains ({slug}.olava.in). Leave empty to use /w/{slug}.
PUBLIC_ROOT_DOMAIN=

# Secure (HTTPS-only) cookies. Defaults to true in production, false in development.
# COOKIE_SECURE=true
